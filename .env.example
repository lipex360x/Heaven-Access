# Local demonstration values only. Keep PostgreSQL bound to loopback.
# Optional comma-separated LAN hostnames/IPs for Next.js development assets (no scheme/port).
DEV_ALLOWED_HOSTS=
POSTGRES_USER=heaven_access
POSTGRES_PASSWORD=local_demo_database
POSTGRES_DB=heaven_access
POSTGRES_PORT=54329
DATABASE_URL=postgresql://heaven_access:local_demo_database@127.0.0.1:54329/heaven_access
